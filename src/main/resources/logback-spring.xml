<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그를 두 갈래로 내보낸다.

  1) 이벤트 기록  - 장식 없이 JSON 한 줄만.
  2) 나머지       - 로컬은 사람이 읽는 글, Cloud Run 은 구조화 JSON.

  Cloud Logging 은 stdout 의 **한 줄이 전체가 JSON 일 때만** 그것을 뜯어 칸으로
  만든다. 앞에 시각이나 레벨이 붙어 있으면 줄을 통째로 글자로 넣어 버려서
  "브라우저가 사파리인 것만" 같은 조건 검색이 안 된다. 그래서 (1)이 따로 있다.

  두 모양이 한 stdout 에 섞여도 괜찮다 - Cloud Logging 은 줄 단위로 판단한다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      스프링 자신의 로그.

      부트는 보통 쓰는 패턴 어펜더와 구조화 어펜더를 **다른 파일로** 둔다. 그래서
      logging.structured.format.console 만 켜도 여기서 패턴 쪽을 넣고 있으면
      아무 일도 안 일어난다. jar 안을 열어 두 파일이 따로인 것을 확인하고 갈랐다.

      구조화 쪽을 쓰는 까닭은 **예외 스택**이다. 패턴으로 찍으면 스택 한 덩어리가
      Cloud Logging 에서 줄마다 따로 쌓여서 무슨 오류였는지 이어 읽기 어렵다.
    -->
    <springProfile name="!cloud">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    </springProfile>
    <springProfile name="cloud">
        <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
    </springProfile>

    <!-- 이벤트 기록. 메시지만 그대로 내보낸다. -->
    <appender name="EVENT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!--
      additivity="false" 가 핵심이다. 없으면 같은 줄이 EVENT 로도, 루트의 CONSOLE
      로도 나가서 **두 번 찍힌다.** 그러면 건수가 두 배로 들어와 숫자를 못 믿는다.
      이 이름은 EventService 의 로거 이름과 짝이다 - 한쪽만 바꾸면 연결이 끊긴다.
    -->
    <logger name="janggi.events.record" level="INFO" additivity="false">
        <appender-ref ref="EVENT"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
